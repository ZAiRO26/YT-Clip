{
  "name": "clipforge-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @clipforge/web dev",
    "build": "pnpm --filter @clipforge/contracts build && pnpm --filter @clipforge/web build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --filter @clipforge/web lint"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
