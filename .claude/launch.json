{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clipforge-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--no-sync", "uvicorn", "app.main:app", "--app-dir", "apps/api", "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "clipforge-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set NEXT_PUBLIC_API_URL=http://localhost:8010&& pnpm --filter @clipforge/web dev --port 3001"],
      "port": 3001
    }
  ]
}
