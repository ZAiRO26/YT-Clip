# ============================================
# ClipForge AI — Backend Environment Variables
# ============================================
# Copy this to .env and fill in your values

# --- Application ---
APP_ENV=development
DEBUG=true

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipforge
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/clipforge

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Gateway (OmniRoute / FreeLLMAPI — OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=auto

# --- Cloudflare R2 (S3-compatible object storage) ---
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clipforge-media

# --- Supabase Auth ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Whisper (transcription) ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Clip Defaults ---
DEFAULT_CLIP_COUNT=5
DEFAULT_MIN_LENGTH_SEC=20
DEFAULT_MAX_LENGTH_SEC=60
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_CAPTION_STYLE=bold_karaoke

# --- Local Paths ---
MEDIA_DIR=./media
TEMP_DIR=./temp
