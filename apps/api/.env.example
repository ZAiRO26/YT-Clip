# ============================================
# ClipForge AI — Monorepo Environment Template (v2)
# ============================================
# Copy this to .env at root or in respective service directories.

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clipforge
POSTGRES_PORT=5432

# --- Redis (Celery Broker & Cache) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- MinIO (S3-Compatible Local Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=clipforge-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Local Media Directory (Dev Mode) ---
MEDIA_DIR=./media
EXPORT_DIR=./exports

# --- LLM Gateway (OpenAI-Compatible Adapter) ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local_gateway_key
LLM_MODEL=auto
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- Local TTS (Kokoro) ---
TTS_ENGINE=kokoro
TTS_VOICE_DEFAULT=warm

# --- Web Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
