# ============================================
# ClipForge AI — Root Environment Variables
# ============================================
# Copy this to .env and fill in your values.
# Frontend and backend each have their own .env files;
# this root file is for docker-compose and shared tooling.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clipforge

# --- Redis ---
REDIS_PORT=6379
